// [Opt 1] Sparse Tile-Skipped Optical Flow via Indirect Dispatch
// Dispatched ONLY for active 16x16 tiles (static tiles cost zero shader invocations).
// Uses coarse block search + sub-pixel Lucas-Kanade refinement in flow-space.
// Output format: RGBA16F -> (vx_px, vy_px, confidence, motion_mag)

struct FlowParams {
    flow_width: u32,
    flow_height: u32,
    src_width: u32,
    src_height: u32,
    tiles_x: u32,
    tiles_y: u32,
    search_radius: i32,
    flow_scale_inv: f32,
};

@group(0) @binding(0) var prev_pyr: texture_2d<f32>;
@group(0) @binding(1) var curr_pyr: texture_2d<f32>;
@group(0) @binding(2) var flow_out: texture_storage_2d<rgba16float, write>;
@group(0) @binding(3) var<uniform> params: FlowParams;
@group(0) @binding(4) var<storage, read> active_tile_coords: array<u32>;

fn sample_luma(tex: texture_2d<f32>, pos: vec2<i32>) -> vec4<f32> {
    let clamped = clamp(pos, vec2<i32>(0), vec2<i32>(i32(params.flow_width) - 1, i32(params.flow_height) - 1));
    return textureLoad(tex, clamped, 0);
}

@compute @workgroup_size(8, 8, 1)
fn main(
    @builtin(workgroup_id) wg_id: vec3<u32>,
    @builtin(local_invocation_id) lid: vec3<u32>,
) {
    // wg_id.x indexes into the compacted active_tile_coords buffer generated by tile_activity.wgsl
    let packed = active_tile_coords[wg_id.x];
    let src_tile_x = packed & 0xFFFFu;
    let src_tile_y = (packed >> 16u) & 0xFFFFu;

    // Map source 16x16 tile into flow-resolution coordinates
    let tile_u0 = f32(src_tile_x * 16u) / f32(params.src_width);
    let tile_v0 = f32(src_tile_y * 16u) / f32(params.src_height);
    let tile_u1 = f32(min((src_tile_x + 1u) * 16u, params.src_width)) / f32(params.src_width);
    let tile_v1 = f32(min((src_tile_y + 1u) * 16u, params.src_height)) / f32(params.src_height);

    let fx0 = u32(floor(tile_u0 * f32(params.flow_width)));
    let fy0 = u32(floor(tile_v0 * f32(params.flow_height)));
    let fx1 = min(u32(ceil(tile_u1 * f32(params.flow_width))), params.flow_width);
    let fy1 = min(u32(ceil(tile_v1 * f32(params.flow_height))), params.flow_height);

    let tile_fw = max(1u, fx1 - fx0);
    let tile_fh = max(1u, fy1 - fy0);

    // Loop over flow pixels belonging to this active tile (covers any flow_scale 0.25..1.0)
    var oy = lid.y;
    loop {
        if (oy >= tile_fh) {
            break;
        }
        var ox = lid.x;
        loop {
            if (ox >= tile_fw) {
                break;
            }
            let p = vec2<i32>(i32(fx0 + ox), i32(fy0 + oy));
            let base = sample_luma(prev_pyr, p);

            // Step 1: Wide coarse search (5-tap cross SAD) reaching +-16 flow px (+-32..36 src px)
            var best_dx: i32 = 0;
            var best_dy: i32 = 0;
            var best_cost: f32 = 1e9;
            let rad = clamp(params.search_radius, 4, 20);
            let coarse_step: i32 = 4;

            for (var dy = -rad; dy <= rad; dy = dy + coarse_step) {
                for (var dx = -rad; dx <= rad; dx = dx + coarse_step) {
                    // 5-tap cross patch: center + 4 cardinal neighbors (fast wide capture envelope)
                    let c0 = base;
                    let c1 = sample_luma(curr_pyr, p + vec2<i32>(dx, dy));
                    var sad = abs(c1.x - c0.x) + 0.35 * (abs(c1.y - c0.y) + abs(c1.z - c0.z));

                    let n0 = sample_luma(prev_pyr, p + vec2<i32>(0, -1));
                    let n1 = sample_luma(curr_pyr, p + vec2<i32>(dx, dy - 1));
                    sad = sad + abs(n1.x - n0.x) + 0.35 * (abs(n1.y - n0.y) + abs(n1.z - n0.z));

                    let s0 = sample_luma(prev_pyr, p + vec2<i32>(0, 1));
                    let s1 = sample_luma(curr_pyr, p + vec2<i32>(dx, dy + 1));
                    sad = sad + abs(s1.x - s0.x) + 0.35 * (abs(s1.y - s0.y) + abs(s1.z - s0.z));

                    let w0 = sample_luma(prev_pyr, p + vec2<i32>(-1, 0));
                    let w1 = sample_luma(curr_pyr, p + vec2<i32>(dx - 1, dy));
                    sad = sad + abs(w1.x - w0.x) + 0.35 * (abs(w1.y - w0.y) + abs(w1.z - w0.z));

                    let e0 = sample_luma(prev_pyr, p + vec2<i32>(1, 0));
                    let e1 = sample_luma(curr_pyr, p + vec2<i32>(dx + 1, dy));
                    sad = sad + abs(e1.x - e0.x) + 0.35 * (abs(e1.y - e0.y) + abs(e1.z - e0.z));

                    // Gentle zero-flow tie-breaker on flat textureless regions
                    let reg = 0.0006 * f32(dx * dx + dy * dy);
                    let cost = sad + reg;
                    if (cost < best_cost) {
                        best_cost = cost;
                        best_dx = dx;
                        best_dy = dy;
                    }
                }
            }

            // Step 2: Full 3x3 patch fine refinement in [-2, +2] around coarse winner
            let cx = best_dx;
            let cy = best_dy;
            best_cost = 1e9;
            for (var dy = -2; dy <= 2; dy = dy + 1) {
                for (var dx = -2; dx <= 2; dx = dx + 1) {
                    let cand_x = cx + dx;
                    let cand_y = cy + dy;
                    var sad: f32 = 0.0;
                    for (var py = -1; py <= 1; py = py + 1) {
                        for (var px = -1; px <= 1; px = px + 1) {
                            let s0 = sample_luma(prev_pyr, p + vec2<i32>(px, py));
                            let s1 = sample_luma(curr_pyr, p + vec2<i32>(px + cand_x, py + cand_y));
                            sad = sad + abs(s1.x - s0.x) + 0.35 * (abs(s1.y - s0.y) + abs(s1.z - s0.z));
                        }
                    }
                    let cost = sad + 0.0008 * f32(cand_x * cand_x + cand_y * cand_y);
                    if (cost < best_cost) {
                        best_cost = cost;
                        best_dx = cand_x;
                        best_dy = cand_y;
                    }
                }
            }

            // Step 3: Sub-pixel Lucas-Kanade refinement using spatial gradients
            let matched = sample_luma(curr_pyr, p + vec2<i32>(best_dx, best_dy));
            let it = matched.x - base.x;
            let ix = 0.5 * (base.y + matched.y);
            let iy = 0.5 * (base.z + matched.z);
            let denom = ix * ix + iy * iy + 0.0025;
            let sub_dx = clamp(-it * ix / denom, -0.75, 0.75);
            let sub_dy = clamp(-it * iy / denom, -0.75, 0.75);

            // Convert flow vector from flow-space pixels to full source-space pixels
            let vx_src = (f32(best_dx) + sub_dx) * params.flow_scale_inv;
            let vy_src = (f32(best_dy) + sub_dy) * params.flow_scale_inv;
            let mag = sqrt(vx_src * vx_src + vy_src * vy_src);
            let conf = clamp(1.0 - best_cost / 4.5, 0.0, 1.0);

            textureStore(flow_out, p, vec4<f32>(vx_src, vy_src, conf, mag));
            ox = ox + 8u;
        }
        oy = oy + 8u;
    }
}
